{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "eslint.enable": true,
  "eslint.format.enable": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "json",
    "jsonc",
    "markdown",
    "mdx",
    "yaml"
  ],
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "ts.tsdk.path": ".yarn/sdks/typescript/lib",
  "ts.tsdk.promptToUseWorkspaceVersion": true
}
