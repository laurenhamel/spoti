{
  "name": "spoti",
  "version": "0.1.0",
  "description": "Yet another Spotify music downloader",
  "type": "module",
  "main": "./bin/cli.js",
  "bin": "./bin/cli.js",
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "format": "yarn format:check --write; yarn lint:fix --quiet",
    "format:check": "prettier . \"$@\"",
    "lint": "eslint . \"$@\"",
    "lint:fix": "yarn lint --fix \"$@\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc \"$@\""
  },
  "keywords": [
    "spotify",
    "spotify-downloader",
    "youtube-music",
    "youtube-downloader"
  ],
  "author": "Lauren Hamel",
  "license": "ISC",
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.2.0",
    "@types/qs": "6.15.1",
    "@types/window-size": "1.1.4",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-lodash-es": "1.2.1",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.67.0"
  },
  "dependencies": {
    "chalk": "6.0.0",
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "fast-safe-stringify": "2.1.1",
    "fuse.js": "7.5.0",
    "glob": "13.0.6",
    "lodash-es": "4.18.1",
    "multi-progress-bars": "5.0.3",
    "node-fetch": "3.3.2",
    "node-id3": "0.2.9",
    "p-limit": "7.3.1",
    "pretty-bytes": "7.1.1",
    "pretty-ms": "9.3.0",
    "qs": "6.15.3",
    "tsx": "4.23.12",
    "window-size": "1.1.1",
    "yargs": "18.1.0",
    "youtubei.js": "18.0.0"
  }
}
